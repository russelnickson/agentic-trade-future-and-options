# Production environment template — copy to .env / .env.production and fill in.
# Never commit real secrets.

# Dhan HQ
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Zerodha Kite
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_USER_ID=
ZERODHA_PASSWORD=
ZERODHA_TOTP_SECRET=

# Hot cache (Redis)
# Example: redis://localhost:6379/0
REDIS_URL=

# Warm store (TimescaleDB / PostgreSQL)
# Example: postgresql://trade:trade@localhost:5432/trade
DATABASE_URL=

# Risk / circuit breaker
MAX_DAILY_LOSS=5000
CIRCUIT_BREAKER_POLL_SEC=5
TRADE_BROKER=dhan

# PM2 / launch_trading_day.sh
# Comma-separated F&O instrument tokens for tick_worker + preflight WS smoke
TRADE_TOKENS=
# Optional smaller set for preflight only (falls back to TRADE_TOKENS)
TRADE_PREFLIGHT_TOKENS=
TRADE_FEED_MODE=full
TRADE_ZMQ_ENDPOINT=tcp://127.0.0.1:5555
TRADE_LATENCY_THRESHOLD_MS=500
TRADE_MAX_CLOCK_DRIFT_MS=50
# STREAMLIT_SERVER_PORT=8501
# DASHBOARD_URL=http://localhost:8501
